# SecureGate AI Environment Configurations
PORT=5000
JWT_SECRET=super_secure_jwt_secret_key_12345
SESSION_TIMEOUT_MS=900000

# AI Configuration (Gemini API)
# If empty, the backend automatically runs in offline Demo Mode using local simulated AI models.
GEMINI_API_KEY=

# Firebase configuration (For Production deployment)
# If empty, the backend automatically falls back to lowdb local JSON file database.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Demo Configuration
# Force mock notifications on screen and use preset admin/employee logins.
DEMO_MODE=true

# Flask ML API Connection
# Set to the URL of the ML team's Flask endpoint. If empty, falls back to rule-based agent.
FLASK_ML_URL=http://localhost:8000
